{
  "name": "@noid-oss/authz",
  "version": "0.1.0",
  "description": "Authorization SDK for the noid brands: token verification, claim hints and live permission checks (fail closed).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22" },
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "sync-vectors": "node scripts/sync-vectors.mjs",
    "check-vectors": "node scripts/sync-vectors.mjs --check",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "jose": "^6.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
